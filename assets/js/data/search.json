---
layout: null
permalink: /assets/js/data/search.json
swcache: true
---

{% assign publications = site.tabs | where: "url", "/publications/" %}
{% assign documents = site.posts | concat: publications %}

[
{% for item in documents %}
  {
    "title": {{ item.title | jsonify }},
    "url": {{ item.url | relative_url | jsonify }},
    "categories": {{ item.categories | join: ', ' | jsonify }},
    "tags": {{ item.tags | join: ', ' | jsonify }},
    "date": {{ item.date | jsonify }},
    "content": {{ item.content | markdownify | strip_html | normalize_whitespace | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
