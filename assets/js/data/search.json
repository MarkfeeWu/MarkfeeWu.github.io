---
layout: null
permalink: /assets/js/data/search.json
swcache: true
---

{% assign publications = site.tabs | where: "url", "/publications/" %}
{% assign documents = site.posts | concat: publications %}

[
{% for item in documents %}
  {% if item.url == "/publications/" %}
    {% capture searchable_text %}
      {% assign blocks = item.content | split: '</li>' %}
      {% for block in blocks %}
        {% if block contains '<li' %}
          {% assign paper_html = block | split: '<li' | last | prepend: '<li' %}
          {{ paper_html | strip_html }}
        {% endif %}
      {% endfor %}
    {% endcapture %}
  {% else %}
    {% assign searchable_text = item.content | markdownify | strip_html %}
  {% endif %}

  {
    "title": {{ item.title | jsonify }},
    "url": {{ item.url | relative_url | jsonify }},
    "categories": {{ item.categories | join: ', ' | jsonify }},
    "tags": {{ item.tags | join: ', ' | jsonify }},
    "date": {{ item.date | jsonify }},
    "content": {{ searchable_text | normalize_whitespace | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
